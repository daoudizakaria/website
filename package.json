{
  "private": true,
  "name": "masterPortfolio",
  "version": "0.1.0",
  "homepage": "https://daoudizakaria.github.io/website",
  "scripts": {
    "build": "craco build",
    "cms:dev": "decap-server",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d build --repo https://github.com/daoudizakaria/website.git --nojekyll --cname www.zakariadaoudi.com",
    "eject": "react-scripts eject",
    "start": "craco start",
    "test": "craco test"
  },
  "dependencies": {
    "baseui": "^18.2.0",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "katex": "0.16.11",
    "prettier-package-json": "^2.1.3",
    "react": "^18.3.1",
    "react-bootstrap": "^1.6.8",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "react-markdown": "8.0.7",
    "react-router-dom": "^5.3.4",
    "react-scripts": "^5.0.1",
    "rehype-katex": "6.0.3",
    "rehype-raw": "^6.1.1",
    "rehype-sanitize": "^5.0.1",
    "remark-gfm": "3.0.1",
    "remark-math": "5.1.1",
    "styled-components": "^5.3.11",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "decap-server": "^3.8.0",
    "dotenv": "^6.2.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "prettier": "2.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": "prettier-package-json --write",
    "*.{js,css,md}": "prettier --write"
  }
}
